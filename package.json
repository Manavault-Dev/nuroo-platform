{
  "name": "nuroo-landing",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": "24.x"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "next lint",
    "lint:fix": "next lint --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "tsc --noEmit",
    "validate": "npm run typecheck && npm run lint && npm run format:check",
    "prepare": "husky",
    "test": "vitest run",
    "test:e2e": "playwright test e2e/smoke.spec.ts --workers=1",
    "test:e2e:product": "playwright test e2e/b2b-auth.spec.ts e2e/connect-page.spec.ts e2e/assignments.spec.ts",
    "test:e2e:headed": "playwright test --headed",
    "test:e2e:ui": "playwright test --ui"
  },
  "dependencies": {
    "@headlessui/react": "^1.7.18",
    "@sentry/nextjs": "^10.53.1",
    "@types/node": "^20.14.12",
    "@types/react": "^18.3.3",
    "@types/react-dom": "^18.3.0",
    "autoprefixer": "^10.4.19",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "firebase": "^10.13.2",
    "framer-motion": "^12.38.0",
    "heic-convert": "^2.1.0",
    "html2canvas": "^1.4.1",
    "jspdf": "^4.2.0",
    "lucide-react": "^0.408.0",
    "next": "14.2.18",
    "next-intl": "^3.25.0",
    "next-seo": "^6.5.0",
    "postcss": "^8.4.39",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "tailwind-merge": "^2.6.0",
    "tailwindcss": "^3.4.7",
    "typescript": "^5.5.3"
  },
  "devDependencies": {
    "@playwright/test": "^1.61.0",
    "@typescript-eslint/eslint-plugin": "^7.18.0",
    "eslint": "^8.57.0",
    "eslint-config-next": "14.2.18",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-prettier": "^5.5.5",
    "husky": "^9.1.7",
    "lint-staged": "^16.2.7",
    "prettier": "^3.8.1",
    "vitest": "^4.1.8"
  }
}
