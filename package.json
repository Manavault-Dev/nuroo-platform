{
  "name": "nuroo-landing",
  "version": "1.2.0",
  "private": true,
  "engines": {
    "node": "24.x"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "next lint",
    "lint:fix": "next lint --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "tsc --noEmit",
    "validate": "npm run typecheck && npm run lint && npm run format:check",
    "prepare": "husky",
    "test": "vitest run",
    "test:e2e": "playwright test e2e/smoke.spec.ts --workers=1",
    "test:e2e:product": "playwright test e2e/b2b-auth.spec.ts e2e/connect-page.spec.ts e2e/assignments.spec.ts",
    "test:e2e:headed": "playwright test --headed",
    "test:e2e:ui": "playwright test --ui"
  },
  "dependencies": {
    "@amplitude/unified": "^1.1.40",
    "@headlessui/react": "^1.7.18",
    "@sentry/nextjs": "^10.76.2",
    "@types/node": "^20.19.43",
    "@types/react": "^18.3.3",
    "@types/react-dom": "^18.3.0",
    "autoprefixer": "^10.6.1",
    "clsx": "^2.1.1",
    "firebase": "^10.13.2",
    "framer-motion": "^12.43.0",
    "heic-convert": "^2.1.0",
    "html2canvas": "^1.4.1",
    "jspdf": "^4.2.0",
    "lucide-react": "^0.577.0",
    "next": "^14.2.29",
    "next-intl": "^3.25.0",
    "postcss": "^8.5.29",
    "qrcode": "^1.5.4",
    "react": "^18.3.1",
    "react-day-picker": "^10.0.2",
    "react-dom": "^18.3.1",
    "tailwind-merge": "^2.6.1",
    "tailwindcss": "^3.4.7",
    "typescript": "^5.9.3"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.0",
    "@types/qrcode": "^1.5.6",
    "@typescript-eslint/eslint-plugin": "^7.18.0",
    "eslint": "^8.57.0",
    "eslint-config-next": "14.2.35",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-prettier": "^5.5.6",
    "husky": "^9.1.7",
    "lint-staged": "^16.4.0",
    "prettier": "^3.9.10",
    "sharp": "^0.35.5",
    "vitest": "^4.1.11"
  }
}
