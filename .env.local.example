# Firebase web application
NEXT_PUBLIC_FIREBASE_API_KEY=your-firebase-api-key
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=your-project.firebaseapp.com
NEXT_PUBLIC_FIREBASE_PROJECT_ID=your-project-id
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=your-project.appspot.com
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=your-sender-id
NEXT_PUBLIC_FIREBASE_APP_ID=your-app-id

# Backend and public web URLs
NEXT_PUBLIC_API_URL=http://127.0.0.1:3101
NEXT_PUBLIC_B2B_URL=http://localhost:3000

# Sentry (web)
NEXT_PUBLIC_SENTRY_DSN=https://your-dsn@sentry.io/project-id
SENTRY_AUTH_TOKEN=your-sentry-auth-token
NEXT_PUBLIC_APP_VERSION=0.1.0

# Firebase Analytics
NEXT_PUBLIC_FIREBASE_ANALYTICS_ENABLED=true

# Amplitude Analytics
NEXT_PUBLIC_AMPLITUDE_API_KEY=your-amplitude-api-key

# ── Google Sign-In (web) ─────────────────────────────────────────────────────
# Enable Google Sign-In in Firebase Console → Authentication → Sign-in method
# Add your domain to: Firebase Console → Authentication → Settings → Authorized domains
# No extra env vars needed — Firebase uses the project's web config automatically
